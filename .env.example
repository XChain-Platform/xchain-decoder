# xchain-decoder configuration. Copy to .env and fill in values.
# The decoder polls a coin node, decodes XChain transactions, and writes them
# to its MariaDB (decoder DB).

# Required: coin and network (e.g. bitcoin-mainnet, bitcoin-regtest,
# litecoin-testnet, dogecoin-mainnet).
NETWORK=bitcoin-regtest

# Required: coin node RPC connection.
NODE_URL=127.0.0.1
NODE_PORT=8332
NODE_USER=rpcuser

# Optional: fallback coin node RPC endpoint(s), comma-separated. Each entry is
# a host, optionally with protocol and/or port (e.g. 10.0.0.2 or
# https://node2.example.com:8332); entries without a port use NODE_PORT.
# The decoder rotates to the next endpoint after NODE_FAILOVER_THRESHOLD
# consecutive connection-level RPC failures, so a dead node no longer stalls
# it indefinitely. Same credentials are used for every endpoint.
# NODE_URL_FALLBACK=

# Optional: consecutive connection failures before failing over (default 3).
# NODE_FAILOVER_THRESHOLD=3
NODE_PASSWORD=rpcpass

# Required: decoder MariaDB connection.
DECODER_DB_HOST=127.0.0.1
DECODER_DB_PORT=3306
DECODER_DB_NAME=xchain_decoder
DECODER_DB_USER=xchain
DECODER_DB_PASS=your-db-password-here

# Optional: JSON-RPC API port the decoder listens on.
DECODER_API_PORT=3002

# Optional: API rate limit in requests per minute per IP (default 100).
# DECODER_RATE_LIMIT_RPM=100

# Optional: enable AuxPoW (merged-mining) block-header parsing, required for
# Dogecoin-family chains. Set to 1/true to enable.
# AUX_POW=

# Optional: coin node RPC timeout in ms (default 30000).
# NODE_RPC_TIMEOUT=30000

# Optional: MariaDB per-query timeout in ms (default 30000).
# DB_QUERY_TIMEOUT=30000

# Optional: coin-node RPC fan-out per raw-transaction sub-batch (default 50).
# Lower it if a large mempool pressures your node's RPC work queue or sockets
# (-429 / connection drops); raise it on a beefy local node for faster sync.
# DECODER_RPC_CONCURRENCY=50
